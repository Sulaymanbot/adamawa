# Adamawa LG Online Voting – SIMULATED ACADEMIC PROTOTYPE
# Copy to backend/.env, then run `python scripts/init_env.py` to fill in secrets.
# Never commit backend/.env.

# --- Environment -----------------------------------------------------------
FLASK_APP=app:create_app
# development | production | testing
FLASK_ENV=development

# --- Secrets (generated by scripts/init_env.py) ------------------------------
# Signs the session cookie. 64 hex chars.
SECRET_KEY=
# AES-256-GCM key for ballots: base64 of 32 random bytes. Keep it OUT of the
# database and source control. Losing it makes stored ballots unreadable.
VOTE_ENCRYPTION_KEY=
# HMAC pepper for voter IDs, OTP codes and IP hashes.
IDENTIFIER_PEPPER=

# --- Database --------------------------------------------------------------
# MySQL 8 (recommended):
DATABASE_URL=mysql+pymysql://adamawa_app:CHANGE_ME@127.0.0.1:3306/adamawa_voting?charset=utf8mb4
# SQLite fallback for quick local runs:
# DATABASE_URL=sqlite:///adamawa_voting.db

# --- Sessions --------------------------------------------------------------
# Set true when served over HTTPS (always true in production config).
SESSION_COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# --- CORS ------------------------------------------------------------------
# The bundled HTML UI is same-origin and needs no CORS. List extra trusted
# frontend origins here (comma-separated) only if you add one.
CORS_ORIGINS=

# --- Rate limits (Flask-Limiter syntax) ------------------------------------
RATELIMIT_ENABLED=true
# Use redis://... when running more than one server process.
RATELIMIT_STORAGE_URI=memory://
LOGIN_RATE_LIMIT=10 per minute;50 per hour
OTP_RATE_LIMIT=5 per minute
VOTE_RATE_LIMIT=5 per minute
REGISTER_RATE_LIMIT=5 per minute;30 per hour

# --- OTP (mock provider; code printed to the dev console only) -------------
OTP_ENABLED=false
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Demo mode -------------------------------------------------------------
DEMO_MODE=true
# Allows limited edits to an election after voting starts (audited, dev only).
DEMO_ADMIN_OVERRIDE=false
# Races with fewer valid votes than this have per-candidate totals withheld.
RESULTS_MIN_RACE_VOTES=3
# Seed credentials. Leave blank to have `flask seed` generate and print them once.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
DEMO_VOTER_PASSWORD=

# --- Logging / privacy -----------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
# hash | none
AUDIT_IP_MODE=hash
ENABLE_HSTS=false
BCRYPT_ROUNDS=12
